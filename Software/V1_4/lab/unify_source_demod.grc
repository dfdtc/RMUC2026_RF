- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: ZMQ PULL + JSON \u89E3\u6790\n-\
      \ \u5185\u90E8\u521B\u5EFA ZMQ PULL socket\uFF0C\u63A5\u6536 JSON \u6D88\u606F\
      \n\"\"\"\n\nimport json\nimport threading\nimport zmq\nfrom gnuradio import\
      \ gr\nimport pmt\nimport time\nfrom gnuradio.filter import firdes, window\n\
      BLUE_FC = 434.42e6\nRED_FC  = 432.7e6 \n\nclass blk(gr.sync_block):\n    def\
      \ __init__(self,samp_rate = 2e6, endpoint=\"tcp://127.0.0.1:5555\", bind=False):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='ZMQ JSON\
      \ Pull Parser (int freq/bw + access_code)',\n            in_sig=None,\n    \
      \        out_sig=None\n        )\n        self.samp_fc = RED_FC\n        self.samp_rate\
      \ = samp_rate\n        self.endpoint = endpoint\n        self.bind = bind\n\
      \        self.running = False\n        self.thread = None\n\n        self.inter1_LPF\
      \ = firdes.low_pass(1, samp_rate*2, 467.5e3,6e3, window=window.WIN_BLACKMAN)\n\
      \        self.inter2_LPF = firdes.low_pass(1, samp_rate*2, 467.5e3,6e3, window=window.WIN_BLACKMAN)\n\
      \        self.inter3_LPF = firdes.low_pass(1, samp_rate*2, 467.5e3,6e3, window=window.WIN_BLACKMAN)\n\
      \        self.current_inter_LPF = self.inter1_LPF\n\n        # \u6CE8\u518C\u8F93\
      \u51FA\u7AEF\u53E3\n        self.message_port_register_out(pmt.intern('samp_fc'))\
      \ #int\n        self.message_port_register_out(pmt.intern('boardcast_delta_freq'))\
      \ #int\n        self.message_port_register_out(pmt.intern('inter_delta_freq'))\
      \     # int\n        self.message_port_register_out(pmt.intern('inter_bw'))\
      \             # int\n        self.message_port_register_out(pmt.intern('inter_LPF'))\
      \           # taps\n\n        # \u542F\u52A8\u63A5\u6536\u7EBF\u7A0B\n     \
      \   self.start_receiver()\n\n    def start_receiver(self):\n        self.running\
      \ = True\n        self.thread = threading.Thread(target=self.receiver_loop)\n\
      \        self.thread.daemon = True\n        self.thread.start()\n\n    def receiver_loop(self):\n\
      \        context = zmq.Context()\n        socket = context.socket(zmq.SUB)\n\
      \n        socket.setsockopt(zmq.CONFLATE, 1)      # \u53EA\u4FDD\u7559\u6700\
      \u65B0\u547D\u4EE4\n        socket.setsockopt(zmq.SUBSCRIBE, b\"\")    # \u8BA2\
      \u9605\u6240\u6709\u4E3B\u9898\n        socket.setsockopt(zmq.RCVTIMEO, 10000)\
      \   # 30\u79D2\u63A5\u6536\u8D85\u65F6\uFF0C\u9632\u6B62\u65E0\u9650\u671F\u963B\
      \u585E\n        if self.bind:\n            socket.bind(self.endpoint)\n    \
      \        print(f\"[ZMQ] Binding PULL to {self.endpoint}\")\n        else:\n\
      \            socket.connect(self.endpoint)\n            print(f\"[ZMQ] Connecting\
      \ PULL to {self.endpoint}\")\n\n        while self.running:\n            try:\n\
      \                msg_bytes = socket.recv()\n                self.process_message(msg_bytes)\n\
      \            except zmq.Again:\n                print(\"[ZMQ] Receive timeout,\
      \ no message received\")\n                continue    \n            except zmq.ZMQError\
      \ as e:\n                print(f\"[ZMQ] Error: {e}\")\n                break\n\
      \            except Exception as e:\n                print(f\"[ZMQ] Unexpected\
      \ error: {e}\")\n                break\n\n        socket.close()\n        context.term()\n\
      \        print(\"[ZMQ] Receiver thread stopped\")\n        if self.delay > 0:\n\
      \            time.sleep(self.delay)\n\n    def process_message(self, msg_bytes):\n\
      \        try:\n            s = msg_bytes.decode('utf-8')\n            data =\
      \ json.loads(s)\n        except Exception as e:\n            print(f\"[Parser]\
      \ JSON decode error: {e}\")\n            return\n        \n        data_boardcast\
      \ = data[\"boardcast\"]\n        data_inter = data[\"inter\"]\n\n        self.team\
      \ = data_boardcast[\"team\"]\n        if self.team == \"red\":\n           \
      \ self.samp_fc = RED_FC\n        elif self.team == \"blue\":\n            self.samp_fc\
      \ = BLUE_FC\n\n        boardcast_delta = self.samp_fc - data_boardcast.get(\"\
      center_freq\")\n        \n        inter_level = data_inter[\"level\"]\n    \
      \    if inter_level == 1:\n            self.current_inter_LPF = self.inter1_LPF\n\
      \        elif inter_level == 2:\n            self.current_inter_LPF = self.inter2_LPF\n\
      \        elif inter_level == 3:\n            self.current_inter_LPF = self.inter3_LPF\n\
      \n        inter_delta = self.samp_fc - data_inter.get(\"center_freq\")\n   \
      \     inter_bw = data_inter.get(\"bandwidth\")\n\n        # \u63D0\u53D6\u5B57\
      \u6BB5\uFF0C\u7F3A\u5931\u65F6\u4F7F\u7528\u9ED8\u8BA4\u503C\u5E76\u62A5\u8B66\
      \n\n        if boardcast_delta is None or inter_delta is None or inter_bw is\
      \ None:\n            missing = []\n            if boardcast_delta is None: missing.append('boardcast_delta')\n\
      \            if inter_delta is None: missing.append('inter_delta')\n       \
      \     if inter_bw is None: missing.append('inter_bw')\n            print(f\"\
      [Parser] Missing keys: {missing} in {data.keys()}\")\n            return\n\n\
      \        # \u8F6C\u6362\u4E3A int (\u622A\u65AD\u5C0F\u6570)\n        boardcast_delta_int\
      \ = int(boardcast_delta)\n        inter_delta_int = int(inter_delta)\n     \
      \   inter_bw_int = int(inter_bw)\n\n        # \u53D1\u9001\u6D88\u606F\n   \
      \     self.message_port_pub(pmt.intern('samp_fc'), \n                      \
      \        pmt.cons(pmt.intern('samp_fc'), pmt.from_long(self.samp_fc)))\n   \
      \     self.message_port_pub(pmt.intern('boardcast_delta'), \n              \
      \                pmt.cons(pmt.intern('boardcast_delta'), pmt.from_long(boardcast_delta_int)))\n\
      \        self.message_port_pub(pmt.intern('interface_delta'), \n           \
      \                   pmt.cons(pmt.intern('interface_delta'), pmt.from_long(inter_delta_int)))\n\
      \        self.message_port_pub(pmt.intern('inter_bw'), \n                  \
      \            pmt.cons(pmt.intern('inter_bw'), pmt.from_long(inter_bw_int)))\n\
      \        self.message_port_pub(pmt.intern('inter_LPF'), \n                 \
      \             pmt.cons(pmt.intern('inter_LPF'), pmt.cons(pmt.intern(\"inter_LPF\"\
      ), pmt.init_f32vector(len(self.current_inter_LPF), self.current_inter_LPF))))\n\
      \        print(\"--------------------------------\")\n        print(f\"[Parser]\
      \ Current team: {self.team},\")\n        print(f\"samp_fc: {self.samp_fc/1e6}\
      \ MHz,\") \n        print(f\"boardcast_delta: {boardcast_delta_int} Hz,\")\n\
      \        print(f\"inter_delta: {inter_delta_int} Hz,\")\n        print(f\"inter_bw:\
      \ {inter_bw_int} Hz\")\n        print(\"--------------------------------\")\n\
      \    def stop(self):\n        self.running = False\n        if self.thread and\
      \ self.thread.is_alive():\n            self.thread.join(timeout=2.0)\n\n   \
      \ def __del__(self):\n        self.stop()"
    affinity: ''
